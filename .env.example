# =====================================================================
# SIDD.WHIZZ — Server Environment Variables Configuration
# =====================================================================
# SECURITY RULE: NEVER prefix secrets or database URLs with VITE_!
# Any VITE_* variable is statically inlined into public browser bundles.

# 1. Neon PostgreSQL Database Connection (Server-Only)
# Replace with your Neon connection strings from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-direct-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Server Session & Cryptographic Signing Secret (Min 32 random chars)
SESSION_SECRET="replace-with-a-strong-random-64-character-server-secret-key"

# 3. Initial Super Admin Bootstrap (Optional — used only when seeding first Super Admin)
ADMIN_BOOTSTRAP_EMAIL="admin@siddwhizz.com"
ADMIN_BOOTSTRAP_PASSWORD=""

# 4. Vercel Blob Media Storage (Optional — falls back cleanly to static/DB assets until set)
BLOB_READ_WRITE_TOKEN=""

# 5. Runtime Environment
NODE_ENV="development"
