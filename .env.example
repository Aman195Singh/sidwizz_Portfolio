# =====================================================================
# SIDD.WHIZZ — Environment Variables Configuration
# =====================================================================

# 1. Neon PostgreSQL Database Connection
# Replace with your actual Neon connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-direct-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Client-accessible DB status indicator (optional)
VITE_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pool-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Configuration
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret-key-12345678"
BETTER_AUTH_URL="http://localhost:8080"

# 3. Environment & Demo Mode
NODE_ENV="development"
DEMO_MODE="true"

